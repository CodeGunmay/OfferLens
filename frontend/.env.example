# ---------------------------------------------------------------------------
# OfferLens frontend environment (Vite)
# Copy to `.env.production` (or `.env.local`) before `npm run build`.
# ---------------------------------------------------------------------------

# Public URL of the FastAPI backend, WITHOUT or WITH the /api suffix —
# both are normalised. Leave empty when FastAPI serves the SPA itself
# (single-process demo) or when `npm run dev` proxies to localhost.
#
# Example: VITE_API_BASE_URL=https://offerlens-api.onrender.com
VITE_API_BASE_URL=

# Legacy alias, honoured if VITE_API_BASE_URL is unset.
# VITE_API_BASE=

# Only used by `npm run dev` — the proxy target for /api.
# VITE_API_TARGET=http://127.0.0.1:8000

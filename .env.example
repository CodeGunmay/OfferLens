# ---------------------------------------------------------------------------
# OfferLens environment configuration (example — copy to .env, never commit .env)
# ---------------------------------------------------------------------------

# Backend
ENVIRONMENT=DEMO WORKSPACE
# SQLite is used for the local demo. Point at PostgreSQL for a deployment:
# DATABASE_URL=postgresql+psycopg://offerlens:password@localhost:5432/offerlens
DATABASE_URL=sqlite:///./offerlens.db
SEED_ON_STARTUP=true
API_PREFIX=/api

# Frontend (Vite). Leave unset in development — the dev server proxies /api.
# VITE_API_BASE=https://your-api-host.example.com/api

# Dev-server proxy target (only used by `npm run dev`)
# VITE_API_TARGET=http://127.0.0.1:8000
